{
    "name": "vedmant/phpunit-pretty-result-printer",
    "description": "PHPUnit Pretty Result Printer",
    "homepage": "https://packagist.org/packages/vedmant/phpunit-pretty-result-printer",
    "keywords": [
        "phpunit",
        "printer",
        "result-printer",
        "composer",
        "package",
        "testing",
        "tdd"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Mike Erickson",
            "email": "codedungeon@gmail.com"
        },
        {
            "name": "Vedmant",
            "email": "vedmant@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "phpunit/phpunit": "^11.0 || ^12.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "2bj/phanybar": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Codedungeon\\PHPUnitPrettyResultPrinter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testsuite Unit"
    },
    "replace": {
        "codedungeon/phpunit-result-printer": "self.version"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
